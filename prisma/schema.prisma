datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String?
  role         String       @default("DEVELOPER")
  avatarUrl    String?
  createdAt    DateTime     @default(now())

  memberships    TeamMember[]
  reportedBugs   Bug[]        @relation("ReportedBugs")
  assignedBugs   Bug[]        @relation("AssignedBugs")
  comments       Comment[]
  auditLogs      AuditLog[]
  ccList         BugCC[]
  flagsSet       Flag[]       @relation("FlagSetters")
  flagsRequested Flag[]       @relation("FlagRequestees")
  attachments    Attachment[]
  savedQueries   SavedQuery[]
}

model Team {
  id        String   @id @default(cuid())
  name      String
  joinCode  String   @unique
  createdAt DateTime @default(now())

  members  TeamMember[]
  products Product[]
  bugs     Bug[]
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String   @default("DEVELOPER") // ADMIN, TRIAGER, DEVELOPER, QA/TESTER, REPORTER
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Product {
  id          String   @id @default(cuid())
  teamId      String?
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  team       Team?       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  components Component[]
  bugs       Bug[]
}

model Component {
  id          String   @id @default(cuid())
  productId   String
  name        String
  description String?
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  bugs    Bug[]

  @@unique([productId, name])
}

model Bug {
  id          String  @id @default(cuid())
  bugNumber   Int     @unique
  key         String  @unique
  title       String
  description String
  status      String  @default("NEW")
  resolution  String?
  severity    String  @default("NORMAL")
  priority    String  @default("P3")

  teamId      String?
  productId   String
  componentId String
  reporterId  String
  assigneeId  String?

  customFields  String? @default("{}")
  duplicateOfId String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  team      Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
  component Component @relation(fields: [componentId], references: [id])
  reporter  User      @relation("ReportedBugs", fields: [reporterId], references: [id])
  assignee  User?     @relation("AssignedBugs", fields: [assigneeId], references: [id])

  comments    Comment[]
  auditLogs   AuditLog[]
  ccList      BugCC[]
  flags       Flag[]
  attachments Attachment[]
}

model Comment {
  id        String   @id @default(cuid())
  bugId     String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  bug    Bug  @relation(fields: [bugId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
}

model AuditLog {
  id           String   @id @default(cuid())
  bugId        String
  actorId      String
  action       String
  fieldChanged String?
  oldValue     String?
  newValue     String?
  prevHash     String?
  hash         String?
  createdAt    DateTime @default(now())

  bug   Bug  @relation(fields: [bugId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id])
}

model BugCC {
  id        String   @id @default(cuid())
  bugId     String
  userId    String
  createdAt DateTime @default(now())

  bug  Bug  @relation(fields: [bugId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bugId, userId])
}

model Flag {
  id          String   @id @default(cuid())
  bugId       String
  setterId    String
  requesteeId String?
  name        String
  status      String
  createdAt   DateTime @default(now())

  bug       Bug   @relation(fields: [bugId], references: [id], onDelete: Cascade)
  setter    User  @relation("FlagSetters", fields: [setterId], references: [id])
  requestee User? @relation("FlagRequestees", fields: [requesteeId], references: [id])
}

model Attachment {
  id         String   @id @default(cuid())
  bugId      String
  uploaderId String
  filename   String
  fileUrl    String
  fileSize   Int
  isPatch    Boolean  @default(false)
  createdAt  DateTime @default(now())

  bug      Bug  @relation(fields: [bugId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id])
}

model SavedQuery {
  id        String   @id @default(cuid())
  userId    String
  name      String
  queryJson String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WhiningRule {
  id           String    @id @default(cuid())
  name         String
  description  String?
  statuses     String
  staleDays    Int       @default(3)
  severities   String?
  isActive     Boolean   @default(true)
  lastRunAt    DateTime?
  lastRunCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}